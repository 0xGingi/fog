# Your domain. DNS: A/AAAA records for it and www.<it> pointing at this server.
FOG_DOMAIN=getfog.org
# Shared secret between fog and coturn. Generate with: openssl rand -hex 32
FOG_TURN_SECRET=
# Optional: push notifications for the phone apps. Put the key files in ./push/ (see README).
# FOG_APNS_KEY=/push/AuthKey_XXXXXXXXXX.p8
# FOG_APNS_KEY_ID=XXXXXXXXXX
# FOG_APNS_TEAM=XXXXXXXXXX
# FOG_FCM_ACCOUNT=/push/firebase-service-account.json

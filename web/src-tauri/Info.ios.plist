<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSCameraUsageDescription</key>
  <string>Fog uses the camera for video calls, video messages and scanning QR codes.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Fog uses the microphone for calls, voice messages and video messages.</string>
  <key>NSPhotoLibraryUsageDescription</key>
  <string>Fog lets you choose photos and videos to send.</string>
  <!-- Calls keep going when you switch apps or lock the phone: without this, iOS suspends the app
       and cuts its microphone, so the other side stops hearing you. -->
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
  </array>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Fog connects to your own Fog server if it runs on this network.</string>
  <key>NSAppTransportSecurity</key>
  <dict>
    <!-- Lets a development build talk to a Fog server on this network over plain HTTP. -->
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
</dict>
</plist>

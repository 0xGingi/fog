{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Fog",
  "version": "0.5.2",
  "identifier": "org.getfog.desktop",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Fog",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 560,
        "url": "app/index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "copyright": "AGPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyNzJGQTRFNEUwMEJBQzUKUldURnVnQk9UdnB5WWtnQzNzVEtXSWtINk1aUXdBVTJWSUlNblBCd0pSajEyRTFYd01hZnlzdi8K",
      "endpoints": [
        "https://github.com/0xGingi/fog/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

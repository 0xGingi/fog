<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Installing a downloaded update (Android asks you to allow it the first time). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application>
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_fog_notification" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="messages" />
        <!-- No Firebase delivery metrics. -->
        <meta-data android:name="delivery_metrics_exported_to_big_query_enabled" android:value="false" />
    </application>
</manifest>

{
  "name": "fog-web",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "core": "cd .. && cargo build -p fog-core --release --target wasm32-unknown-unknown && wasm-bindgen --target web --out-dir web/src/core target/wasm32-unknown-unknown/release/fog_core.wasm",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:desktop": "tsc --noEmit && vite build --mode desktop",
    "desktop": "tauri build"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "jsqr": "1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
